// frame_blur.comp -- the Reloaded menus' backdrop ("*frameblur", vk_blur.c):
// the frame at a quarter of its size blurred by a Gaussian of pc.sigma
// texels, a pass each way: across, from the quarter (rgba8) into a
// half-float image, then down (VERTICAL), from it back into the quarter.
// pc.radius texels each side (three sigmas); past the edges the edge texel

#version 450

layout( local_size_x = 8, local_size_y = 8 ) in;

#ifdef VERTICAL
layout( set = 0, binding = 0, rgba16f ) uniform readonly image2D u_src;
layout( set = 0, binding = 1, rgba8 ) uniform writeonly image2D u_dst;
const ivec2 c_step = ivec2( 0, 1 );
#else
layout( set = 0, binding = 0, rgba8 ) uniform readonly image2D u_src;
layout( set = 0, binding = 1, rgba16f ) uniform writeonly image2D u_dst;
const ivec2 c_step = ivec2( 1, 0 );
#endif

layout( push_constant ) uniform Push {
	ivec2	size;
	float	sigma;
	int		radius;
} pc;

void main() {
	ivec2 p = ivec2( gl_GlobalInvocationID.xy );
	ivec2 hi = pc.size - 1;
	float k = -0.5 / ( pc.sigma * pc.sigma );
	vec4 sum;
	float wsum = 1.0;
	int i;

	if ( any( greaterThan( p, hi ) ) ) {
		return;
	}
	sum = imageLoad( u_src, p );
	for ( i = 1; i <= pc.radius; i++ ) {
		float w = exp( float( i * i ) * k );
		ivec2 o = c_step * i;

		sum += w * ( imageLoad( u_src, clamp( p + o, ivec2( 0 ), hi ) ) + imageLoad( u_src, clamp( p - o, ivec2( 0 ), hi ) ) );
		wsum += 2.0 * w;
	}
	imageStore( u_dst, p, sum / wsum );
}
