// The Reloaded scoreboard, shown for DM_Scoreboard, DM_Round_Scoreboard and Obj_Scoreboard (cl_uimenus.cpp)
menu "reloaded_scoreboard" 640 480 NONE 0
align left top
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle NONE
virtualres 1
drawcache 1

resource
ReloadedMenu
{
name "board"
rect 0 0 640 480
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
screen scoreboard
}

end.
