// The HDR calibration's second screen, over the first: the peak, r_hdrPeak; FINISH ends the calibration (cl_ui.cpp
// closes both). Black where the renderer draws its pattern (cl_uimain.cpp)
menu "hdr_calibrate_peak" 640 480 NONE 0
align left top
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 1.00
borderstyle NONE
bgfill 0.00 0.00 0.00 1.00
fullscreen 1
virtualres 1
drawcache 1

resource
ReloadedMenu
{
name "front"
rect 0 0 640 480
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
screen hdrpeak
stuffcommand "set r_hdrOutputTest 0"
}

end.
