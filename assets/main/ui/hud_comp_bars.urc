// The Competitive HUD (cg_hudstyle 1): under the middle, a slim line in the
// HUD's yellow on a faint track of it: the grenade's charge filling from its
// left; the stopwatch of a bomb planted or defused shrinking to its middle.
// Both at once: the charge's line moved up, the stopwatch's down
menu "hud_comp_bars" 300 80 NONE 0
virtualres 1 1920 1080
drawcache 1
anchor 0.5 0.75
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "chargetrack"
rect 50 30 200 4
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_charge_on
shape fill $ui_hud_acc 0.25
shadow
moveif stopwatchtrack 0 -6
}

resource
Label
{
name "charge"
rect 50 30 200 4
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_charge_on
widthcvar ui_hud_charge left
shape fill $ui_hud_acc 1
shadow
moveif stopwatchtrack 0 -6
}

resource
Label
{
name "stopwatchtrack"
rect 50 30 200 4
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_stopwatch_on
shape fill $ui_hud_acc 0.25
shadow
moveif chargetrack 0 6
}

resource
Label
{
name "stopwatch"
rect 50 30 200 4
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_stopwatch_on
widthcvar ui_hud_stopwatch
shape fill $ui_hud_acc 1
shadow
moveif chargetrack 0 6
}

end.
