// The Competitive HUD (cg_hudstyle 1): under the middle, the grenade's
// charge (five parts) and the stopwatch of a bomb planted or defused, a bar
// shrinking to its middle
menu "hud_comp_bars" 300 80 NONE 0
virtualres 1 1920 1080
drawcache 1
anchor 0.5 0.75
bgcolor 0 0 0 0
borderstyle NONE

resource
Label
{
name "chargeback"
rect 0 20 300 24
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_charge_on
shape fill 0.047 0.055 0.071 0.78
moveif stopwatch 0 -16
}

resource
Label
{
name "charge"
rect 0 20 300 24
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_charge_on
widthcvar ui_hud_charge
shape fill 0.102 0.435 0.831 0.667
moveif stopwatch 0 -16
}

resource
Label
{
name "chargeparts"
rect 0 20 300 24
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_charge_on
shape frame 1 1 1 1 0.102
shape poly 1 1 1 0.102 0.2 0 0.20333 0 0.20333 1 0.2 1
shape poly 1 1 1 0.102 0.4 0 0.40333 0 0.40333 1 0.4 1
shape poly 1 1 1 0.102 0.6 0 0.60333 0 0.60333 1 0.6 1
shape poly 1 1 1 0.102 0.8 0 0.80333 0 0.80333 1 0.8 1
moveif stopwatch 0 -16
}

resource
Label
{
name "stopwatch"
rect 0 20 300 24
bgcolor 0 0 0 0
borderstyle NONE
enabledcvar ui_hud_stopwatch_on
widthcvar ui_hud_stopwatch
shape fill 0.102 0.435 0.831 0.667
moveif chargeback 0 16
}

end.
